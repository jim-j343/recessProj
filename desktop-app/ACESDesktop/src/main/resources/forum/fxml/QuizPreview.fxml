<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.QuizPreviewController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <javafx.scene.image.ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                        <image><javafx.scene.image.Image url="@../images/logo.jpg"/></image>
                    </javafx.scene.image.ImageView>
                </HBox>
                <Label text="Dashboard"   styleClass="nav-link" onMouseClicked="#onDashboard"/>
                <Label text="Groups"      styleClass="nav-link" onMouseClicked="#onGroups"/>
                <Label text="New Topic"   styleClass="nav-link" onMouseClicked="#onNewTopic"/>
                <Label text="Quiz Center" styleClass="nav-link,active" onMouseClicked="#onQuizCenter"/>
                <Label text="Grading"     styleClass="nav-link" onMouseClicked="#onGrading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="Profile" onAction="#onProfile"/>
                        <MenuItem text="Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <Label text="Quiz Preview" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Back to Dashboard" styleClass="btn,btn-secondary" onAction="#onBack"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="16" maxWidth="900">

                    <!-- Meta card: title, badge, course/group/opens/duration/marks -->
                    <VBox styleClass="card-flat" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="quizTitleLabel" style="-fx-font-weight:bold; -fx-font-size:18px;"/>
                                <Label fx:id="quizMetaLabel" styleClass="subtle"/>
                            </VBox>
                            <Label fx:id="statusBadge" styleClass="badge,badge-success"/>
                            <Button fx:id="editBtn" text="Edit Draft" styleClass="btn,btn-outline" onAction="#onEdit" visible="false" managed="false"/>
                            <Button fx:id="publishBtn" text="Publish Quiz" onAction="#onPublish" styleClass="btn,btn-primary" visible="false" managed="false"/>
                        </HBox>
                        <HBox spacing="32">
                            <VBox spacing="2">
                                <Label text="OPENS" styleClass="eyebrow"/>
                                <Label fx:id="opensLabel" styleClass="label-strong"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="DURATION" styleClass="eyebrow"/>
                                <Label fx:id="durationLabel" styleClass="label-strong"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="TOTAL MARKS" styleClass="eyebrow"/>
                                <Label fx:id="totalMarksLabel" styleClass="label-strong"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Completion -->
                    <VBox styleClass="card-flat" spacing="6">
                        <Label text="Completion" styleClass="card-title"/>
                        <Label fx:id="statsLabel" style="-fx-font-size:22px; -fx-font-weight:bold;"/>
                    </VBox>

                    <!-- Questions -->
                    <VBox styleClass="card-flat" spacing="8">
                        <Label fx:id="questionsHeaderLabel" text="Questions" style="-fx-font-weight:bold;"/>
                        <VBox fx:id="questionsBox" spacing="8"/>
                    </VBox>

                    <!-- Submissions -->
                    <VBox styleClass="card-flat" spacing="8">
                        <Label text="Completed Submissions" style="-fx-font-weight:bold;"/>
                        <ListView fx:id="submissionsList" prefHeight="200"/>
                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="Footer.fxml"/>
    </bottom>
</BorderPane>