<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.QuizPreviewController"
            stylesheets="@../css/aces.css" styleClass="root" prefWidth="900" prefHeight="600">
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT">
            <Label text="Quiz Preview" styleClass="nav-link,active"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="avatarLabel" styleClass="avatar" text="?"/>
            <Label fx:id="userNameLabel" text=""/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12" style="-fx-padding:20;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="quizTitleLabel" style="-fx-font-weight:bold; -fx-font-size:16px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="editBtn" text="Edit Draft" onAction="#onEdit" visible="false" managed="false"/>
                <Button fx:id="publishBtn" text="Publish Quiz" onAction="#onPublish" styleClass="btn,btn-primary" visible="false" managed="false"/>
                <Button fx:id="backBtn" text="Back" onAction="#onBack"/>
            </HBox>
            <Label fx:id="statsLabel" styleClass="muted"/>
            <VBox spacing="8">
                <Label text="Questions" style="-fx-font-weight:bold;"/>
                <VBox fx:id="questionsBox" spacing="8" style="-fx-padding:8; -fx-background-color:#fff; -fx-border-color:#e5e7eb; -fx-border-radius:8; -fx-background-radius:8;"/>
            </VBox>
            <Label text="Completed Submissions" style="-fx-font-weight:bold; -fx-padding:8 0 0 0;"/>
            <ListView fx:id="submissionsList" prefHeight="200"/>
        </VBox>
    </center>
</BorderPane>