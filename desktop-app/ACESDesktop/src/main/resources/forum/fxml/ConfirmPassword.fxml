<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Confirm Password — mirrors web auth/confirm-password.blade.php -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           stylesheets="@../css/aces.css" styleClass="root,auth-canvas"
           prefWidth="900" prefHeight="600">
    <VBox alignment="CENTER" maxWidth="448" spacing="16">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        <Label text="Smart Discussion Forum" styleClass="brand"/>
        <VBox styleClass="auth-card" spacing="16" maxWidth="448">
            <Label text="This is a secure area of the application. Please confirm your password before continuing." styleClass="muted" wrapText="true"/>
            <VBox spacing="6">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField/>
            </VBox>
            <HBox alignment="CENTER_RIGHT">
                <Button text="CONFIRM" styleClass="btn,btn-dark"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
