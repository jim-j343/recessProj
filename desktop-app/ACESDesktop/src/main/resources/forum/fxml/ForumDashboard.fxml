<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<!-- ACES · Forum Dashboard  (UI only) -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="2">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="24" left="8"/></padding>
                <ImageView fitWidth="34" fitHeight="34" preserveRatio="true"><image><Image url="@../images/aces-logo.png"/></image></ImageView>
                <VBox>
                    <Label text="ACES" styleClass="brand-name"/>
                    <Label text="Academic Portal" styleClass="brand-sub"/>
                </VBox>
            </HBox>
            <Button text="Dashboard"     styleClass="nav-item,active" maxWidth="Infinity"/>
            <Button text="Discussions"   styleClass="nav-item" maxWidth="Infinity"/>
            <Button text="My Courses"     styleClass="nav-item" maxWidth="Infinity"/>
            <Button text="Quiz Center"    styleClass="nav-item" maxWidth="Infinity"/>
            <Button text="Participation"  styleClass="nav-item" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="divider-pad">
                <padding><Insets top="12"/></padding>
                <Label text="AR" styleClass="brand-logo" minWidth="34" minHeight="34"/>
                <VBox>
                    <Label text="Alex Rivera" styleClass="label-strong"/>
                    <Label text="Student · Level 4" styleClass="brand-sub"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox>
            <!-- TOPBAR -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label text="Dashboard" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField promptText="Search topics…" prefWidth="320"/>
                <Button text="⌕" styleClass="btn,btn-secondary"/>
                <Label text="AR" styleClass="brand-logo" minWidth="34" minHeight="34"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="content">
                <VBox spacing="24" maxWidth="1200">
                    <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>

                    <!-- AI recommended -->
                    <Label text="✦ AI RECOMMENDED TOPICS" styleClass="eyebrow"/>
                    <HBox spacing="16">
                        <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="NEW FOR YOU" styleClass="badge,badge-accent"/>
                            <Label text="Advanced React Patterns" styleClass="h-sm" wrapText="true"/>
                            <Label text="124 active members" styleClass="muted"/>
                        </VBox>
                        <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="RECOMMENDED" styleClass="badge,badge-neutral"/>
                            <Label text="LLM Integration Strategies" styleClass="h-sm" wrapText="true"/>
                            <Label text="89 active members" styleClass="muted"/>
                        </VBox>
                        <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="RECOMMENDED" styleClass="badge,badge-neutral"/>
                            <Label text="Distributed Systems 101" styleClass="h-sm" wrapText="true"/>
                            <Label text="250+ active members" styleClass="muted"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="24">
                        <!-- Recent discussions -->
                        <VBox styleClass="card" spacing="0" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="16">
                                <Label text="Recent Discussions" styleClass="card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="＋ New Thread" styleClass="btn,btn-primary"/>
                            </HBox>
                            <Separator styleClass="divider"><padding><Insets top="16" bottom="16"/></padding></Separator>
                            <VBox spacing="8">
                                <Label text="Best practices for cleaning massive datasets in Python?" styleClass="h-sm" wrapText="true"/>
                                <Label text="I'm working with a 50GB CSV and the standard pandas approach is hitting OOM errors. Dask vs Polars?" styleClass="muted" wrapText="true"/>
                                <HBox spacing="6">
                                    <Label text="#DataScience" styleClass="chip"/>
                                    <Label text="#Python" styleClass="chip"/>
                                    <Label text="#Optimization" styleClass="chip"/>
                                </HBox>
                            </VBox>
                            <Separator styleClass="divider"><padding><Insets top="16" bottom="16"/></padding></Separator>
                            <VBox spacing="8">
                                <Label text="Is micro-frontend architecture still viable in 2026?" styleClass="h-sm" wrapText="true"/>
                                <Label text="We've used Module Federation for a year, but the overhead is significant. Is monolith-first the trend again?" styleClass="muted" wrapText="true"/>
                                <HBox spacing="6">
                                    <Label text="#ComputerScience" styleClass="chip"/>
                                    <Label text="#Architecture" styleClass="chip"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Right rail -->
                        <VBox spacing="24" prefWidth="320" minWidth="320">
                            <VBox styleClass="card" spacing="12">
                                <Label text="Your Statistics" styleClass="card-title"/>
                                <HBox spacing="16">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="MARKS EARNED" styleClass="eyebrow"/>
                                        <Label text="124" styleClass="metric-value"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="CONTRIBUTIONS" styleClass="eyebrow"/>
                                        <Label text="8" styleClass="metric-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Progress to Expert Tier — 82%" styleClass="muted"/>
                                <ProgressBar progress="0.82" maxWidth="Infinity"/>
                            </VBox>
                            <VBox styleClass="card" spacing="12">
                                <Label text="Unanswered" styleClass="card-title"/>
                                <VBox spacing="4">
                                    <Label text="URGENT" styleClass="badge,badge-danger"/>
                                    <Label text="How to handle race conditions in distributed systems?" styleClass="label-strong" wrapText="true"/>
                                    <Label text="8m ago" styleClass="muted"/>
                                </VBox>
                                <Separator styleClass="divider"/>
                                <VBox spacing="4">
                                    <Label text="WebAssembly vs JS for high-perf computation?" styleClass="label-strong" wrapText="true"/>
                                    <Label text="Trending · 2h ago" styleClass="muted"/>
                                </VBox>
                                <Button text="Browse All Unanswered" styleClass="btn,btn-secondary" maxWidth="Infinity"/>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
