<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Discussion Forum — mirrors web forum/index.blade.php (top-nav layout) -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.ForumDashboardController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <!-- NAV BAR -->
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
<javafx.scene.image.ImageView fitWidth="48" fitHeight="48" preserveRatio="true"><image><javafx.scene.image.Image url="@../images/logo.jpg"/></image></javafx.scene.image.ImageView>
<Label text="Dashboard" styleClass="nav-link" onMouseClicked="#onDashboard"/>
<Label text="Groups"    styleClass="nav-link" onMouseClicked="#onGroups"/>
<Label fx:id="navMyProgress" text="My Progress" styleClass="nav-link" onMouseClicked="#onDashboard" managed="false" visible="false"/>
<Label fx:id="navNewTopic" text="New Topic" styleClass="nav-link" onMouseClicked="#onNewTopic" managed="false" visible="false"/>
<Label fx:id="navQuizCenter" text="Quiz Center" styleClass="nav-link" onMouseClicked="#onQuizCenter" managed="false" visible="false"/>
<Label fx:id="navGrading"    text="Grading"     styleClass="nav-link" onMouseClicked="#onGrading" managed="false" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="nav-user" alignment="CENTER_LEFT" spacing="8" onMouseClicked="#onLogout">
                    <Label fx:id="avatarLabel" text="?" styleClass="avatar" minWidth="32" minHeight="32"/>
                    <Label fx:id="userNameLabel" text="Signed in"/>
                    <Label fx:id="userMetaLabel" text="Student" visible="false" managed="false"/>
                    <Label text="Log out ▾" styleClass="subtle"/>
                </HBox>
            </HBox>
            <!-- HEADER BAND -->
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <Label text="Discussion Forum" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ New Topic" styleClass="btn,btn-primary" onAction="#onNewThread"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="16" maxWidth="1152">
                    <!-- Search bar card -->
                    <VBox styleClass="card">
                        <TextField promptText="Search topics..." maxWidth="Infinity"/>
                    </VBox>

                    <!-- Topic list (rows injected by controller) -->
                    <VBox styleClass="card" spacing="0">
                        <Label text="Recent Discussions" styleClass="card-title"/>
                        <Region styleClass="divider" prefHeight="1"><VBox.margin><Insets top="14" bottom="6"/></VBox.margin></Region>
                        <VBox fx:id="discussionList" spacing="0"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

