<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<!-- ACES - Topic Detail  (wired to local cache) -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.TopicDetailController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <left>
        <VBox styleClass="sidebar" spacing="2">
            <HBox alignment="CENTER_LEFT" spacing="10"><padding><Insets bottom="24" left="8"/></padding>
                <ImageView fitWidth="34" fitHeight="34" preserveRatio="true"><image><Image url="@../images/aces-logo.png"/></image></ImageView>
                <VBox><Label text="ACES" styleClass="brand-name"/><Label text="Academic Portal" styleClass="brand-sub"/></VBox>
            </HBox>
            <Button text="Dashboard"   styleClass="nav-item" maxWidth="Infinity" onAction="#onBack"/>
            <Button text="Discussions" styleClass="nav-item,active" maxWidth="Infinity" onAction="#onBack"/>
            <Button text="My Courses"   styleClass="nav-item" maxWidth="Infinity"/>
            <Button text="Quiz Center" styleClass="nav-item" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <VBox>
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
                <Hyperlink text="← Back" onAction="#onBack"/>
                <Label fx:id="topicTitleLabel" text="Topic" styleClass="page-title"/>
            </HBox>
            <ScrollPane fitToWidth="true" styleClass="content">
                <VBox spacing="16" maxWidth="820">
                    <Label fx:id="repliesCountLabel" text="Replies" styleClass="h-sm"/>
                    <VBox fx:id="postList" spacing="12"/>

                    <!-- Composer -->
                    <HBox styleClass="card" spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="composerField" promptText="Add to the conversation…" HBox.hgrow="ALWAYS" onAction="#onReply"/>
                        <Button text="Reply →" styleClass="btn,btn-primary" onAction="#onReply"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
