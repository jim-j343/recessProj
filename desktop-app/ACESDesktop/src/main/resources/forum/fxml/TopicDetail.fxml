<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Topic Detail — mirrors web forum/show.blade.php (thread + sticky reply bar) -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.TopicDetailController"
            stylesheets="@../css/aces.css" styleClass="root" style="-fx-background-color:#f9fafb;"
            prefWidth="1280" prefHeight="820">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color:white; -fx-border-color:#e5e7eb; -fx-border-width:0 0 1 0; -fx-padding:12 24 12 24;">
            <Hyperlink text="← Back" onAction="#onBack" styleClass="muted"/>
            <Label fx:id="topicTitleLabel" text="Topic" styleClass="label-strong"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="↓ Export PDF" styleClass="btn-sm,btn-outline" onAction="#onExportPdf"/>
            <Button text="↗ Share" styleClass="btn-sm,btn-outline" onAction="#onShare"/>
            <Button fx:id="editTopicBtn" text="✎ Edit" styleClass="btn-sm,btn-outline" onAction="#onEditTopic" managed="false" visible="false"/>
            <Button fx:id="deleteTopicBtn" text="Delete" style="-fx-background-color:#ef4444; -fx-text-fill:white; -fx-font-size:12px; -fx-padding:4 10 4 10; -fx-background-radius:6; -fx-cursor:hand;" onAction="#onDeleteTopic" managed="false" visible="false"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="16" maxWidth="768">
                    <Label fx:id="repliesCountLabel" text="Replies" styleClass="h-sm"/>
                    <VBox fx:id="postList" spacing="16"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- STICKY REPLY BAR -->
    <bottom>
        <VBox style="-fx-background-color:white; -fx-border-color:#e5e7eb; -fx-border-width:1 0 0 0;">
            <VBox fx:id="excludePickerBox" spacing="6" managed="false" visible="false"
                  style="-fx-background-color:#fffbeb; -fx-border-color:#fde68a; -fx-border-width:0 0 1 0; -fx-padding:10 24 10 24;">
                <Label text="Hide this reply from:" styleClass="subtle" style="-fx-font-size:11px; -fx-font-weight:600;"/>
                <VBox fx:id="excludeCheckboxList" spacing="4"/>
            </VBox>
            <HBox alignment="CENTER" style="-fx-padding:12 24 12 24;">
                <HBox spacing="12" alignment="CENTER_LEFT" maxWidth="768" HBox.hgrow="ALWAYS">
                    <Button fx:id="excludeToggleBtn" text="🔒" styleClass="btn-sm,btn-outline" onAction="#onToggleExcludePicker"/>
                    <Label fx:id="excludeCountBadge" text="" managed="false" visible="false"
                           styleClass="badge,badge-warning" style="-fx-font-size:10px;"/>
                    <TextField fx:id="composerField" promptText="Add to the conversation..." HBox.hgrow="ALWAYS" onAction="#onReply"/>
                    <Button text="↩ Reply" styleClass="btn,btn-dark" onAction="#onReply"/>
                </HBox>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
