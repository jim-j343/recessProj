<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Create New Group — mirrors web groups/create.blade.php -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
                <Label text="Smart Discussion Forum" styleClass="brand"/>
                <Label text="Dashboard" styleClass="nav-link"/>
                <Label text="Groups" styleClass="nav-link,active"/>
                <Label text="Analytics" styleClass="nav-link"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="nav-user" alignment="CENTER_LEFT" spacing="8">
                    <Label text="SJ" styleClass="avatar" minWidth="32" minHeight="32"/>
                    <Label text="Dr. Sarah Jenkins"/>
                    <Label text="▾" styleClass="subtle"/>
                </HBox>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <Label text="Create New Group" styleClass="page-title"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <VBox alignment="TOP_CENTER">
                <VBox maxWidth="672">
                    <VBox styleClass="card" spacing="16">
                        <VBox spacing="6">
                            <Label text="Group Name *" styleClass="field-label"/>
                            <TextField promptText="e.g. Computer Science Year 2"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Description (optional)" styleClass="field-label"/>
                            <TextArea promptText="What is this group about?" prefRowCount="3" wrapText="true"/>
                        </VBox>
                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Days before warning *" styleClass="field-label"/>
                                <TextField text="7"/>
                                <Label text="Days of inactivity before warning" styleClass="subtle"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Blacklist duration (days) *" styleClass="field-label"/>
                                <TextField text="30"/>
                                <Label text="How long blacklisted members are banned" styleClass="subtle"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="16">
                            <Hyperlink text="Cancel" styleClass="muted"/>
                            <Button text="Create Group" styleClass="btn,btn-primary"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
