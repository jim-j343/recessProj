<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Create New Topic — mirrors web forum/create.blade.php -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.TopicCreationController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
                <Label text="Smart Discussion Forum" styleClass="brand"/>
                <Label text="Dashboard" styleClass="nav-link" onMouseClicked="#onDashboard"/>
                <Label text="Groups" styleClass="nav-link" onMouseClicked="#onGroups"/>
                <Label text="New Topic" styleClass="nav-link,active"/>
                <Label text="Quiz Center" styleClass="nav-link" onMouseClicked="#onQuizCenter"/>
                <Label text="Grading" styleClass="nav-link" onMouseClicked="#onGrading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="✓  Profile" onAction="#onProfile"/>
                        <MenuItem text="→  Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <Label text="Create New Topic" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Back to Forum" styleClass="btn,btn-secondary" onAction="#onCancel"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <VBox alignment="TOP_CENTER">
                <VBox maxWidth="896">
                    <VBox styleClass="card" spacing="16">
                        <VBox spacing="6">
                            <Label text="Topic Title" styleClass="field-label"/>
                            <TextField fx:id="titleField" promptText="Enter a clear, descriptive title..."/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Category (optional)" styleClass="field-label"/>
                            <ComboBox fx:id="categoryCombo" promptText="-- Select a category --" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Group *" styleClass="field-label"/>
                            <ComboBox fx:id="groupCombo" promptText="-- Select a group --" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Description" styleClass="field-label"/>
                            <TextArea fx:id="descriptionArea" promptText="Describe your topic in detail..." prefRowCount="8" wrapText="true"/>
                        </VBox>
                        <Label fx:id="errorLabel" wrapText="true" managed="false" visible="false" style="-fx-text-fill:#dc2626; -fx-font-size:13px;"/>
                        <HBox alignment="CENTER_RIGHT" spacing="16">
                            <Hyperlink text="Cancel" onAction="#onCancel" styleClass="muted"/>
                            <Button text="Post Topic" styleClass="btn,btn-primary" onAction="#onPublish"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
