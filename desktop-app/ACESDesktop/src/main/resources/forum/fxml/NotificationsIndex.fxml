<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.NotificationsIndexController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <javafx.scene.image.ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                        <image><javafx.scene.image.Image url="@../images/aces-logo.png"/></image>
                    </javafx.scene.image.ImageView>
                    <Label text="ACES" styleClass="brand"/>
                </HBox>
                <Label text="Dashboard" styleClass="nav-link" onMouseClicked="#onDashboard"/>
                <Label text="Groups"    styleClass="nav-link" onMouseClicked="#onGroups"/>
                <Label text="Forum"     styleClass="nav-link" onMouseClicked="#onForum"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Notification bell — populated dynamically from backend -->
                <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                            <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                                   style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                                   StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                                   managed="false" visible="false"/>
                        </StackPane>
                    </graphic>
                    <items>
                        <!-- Items populated by NavbarHelper.loadNotifications() -->
                    </items>
                </MenuButton>

                <!-- Profile Dropdown -->
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="✓  Profile" onAction="#onProfile"/>
                        <MenuItem text="→  Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Notifications" styleClass="page-title"/>
                    <Label text="All your recent activity and updates." styleClass="subtle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="markAllReadBtn" text="Mark all read" styleClass="btn,btn-primary" 
                        onAction="#onMarkAllRead" managed="false" visible="false"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="800" minWidth="600">
                    <VBox fx:id="notificationsBox" styleClass="card" spacing="0">
                        <Label fx:id="loadingLabel" text="Loading notifications..." styleClass="subtle" alignment="CENTER" maxWidth="Infinity" />
                        <!-- Populated by controller -->
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
