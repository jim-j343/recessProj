<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>
<?import forum.ui.RevealPasswordField?>
<?import forum.ui.IconTextField?>

<!-- ACES - Login  (UI only, no controller logic yet) -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="forum.controllers.LoginController"
           stylesheets="@../css/aces.css" styleClass="root,auth" style="-fx-background-color: white;"
           prefWidth="900" prefHeight="640">
    <fx:define>
        <ToggleGroup fx:id="role"/>
    </fx:define>
    <VBox alignment="TOP_CENTER" maxWidth="420" spacing="20">
        <padding><Insets top="40" right="16" bottom="40" left="16"/></padding>

        <VBox alignment="CENTER" spacing="6">
            <ImageView fitWidth="52" fitHeight="52" preserveRatio="true"><image><Image url="@../images/aces-logo.png"/></image></ImageView>
            <Label text="ACES" styleClass="display"/>
        </VBox>

        <VBox styleClass="auth-surface" spacing="16" maxWidth="420">
            <HBox styleClass="segmented" alignment="CENTER" spacing="0">
                <ToggleButton text="Student"  toggleGroup="$role" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ToggleButton text="Lecturer" toggleGroup="$role" selected="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ToggleButton text="Admin"    toggleGroup="$role" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox spacing="6">
                <Label text="Email Address" styleClass="field-label"/>
                <IconTextField fx:id="emailField" icon="mail" promptText="your.email@example.com" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="field-label"/>
                <RevealPasswordField fx:id="passwordField" promptText="Enter your password" maxWidth="Infinity"/>
            </VBox>

            <HBox alignment="CENTER_LEFT">
                <CheckBox fx:id="rememberMe" text="Remember me"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot Password?"/>
            </HBox>

            <Label fx:id="errorLabel" wrapText="true" managed="false" visible="false" style="-fx-text-fill:#dc2626; -fx-font-size:13px;"/>
            <Button fx:id="signInButton" text="Sign In" styleClass="btn,btn-primary" maxWidth="Infinity" onAction="#onSignIn"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an account?" styleClass="muted"/>
                <Hyperlink fx:id="signUpLink" text="Sign Up" onAction="#onSignUp"/>
            </HBox>
        </VBox>

        <HBox alignment="CENTER" spacing="4">
            <Label text="Need help accessing your account?" styleClass="muted"/>
            <Hyperlink text="Contact Administrator"/>
        </HBox>
    </VBox>
</StackPane>
