<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- ACES - Login  (UI only, no controller logic yet) -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           stylesheets="@../css/aces.css" styleClass="root"
           prefWidth="900" prefHeight="640">
    <fx:define>
        <ToggleGroup fx:id="role"/>
    </fx:define>
    <VBox alignment="TOP_CENTER" maxWidth="420" spacing="20">
        <padding><Insets top="40" right="16" bottom="40" left="16"/></padding>

        <VBox alignment="CENTER" spacing="6">
            <Label text="A" styleClass="brand-logo" minWidth="52" minHeight="52" prefWidth="52" prefHeight="52"/>
            <Label text="ACES" styleClass="display"/>
            <Label text="Sign in to access your personalized dashboard" styleClass="muted"/>
        </VBox>

        <VBox styleClass="card" spacing="16" maxWidth="420">
            <HBox styleClass="segmented" alignment="CENTER" spacing="0">
                <ToggleButton text="Student"  toggleGroup="$role" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ToggleButton text="Lecturer" toggleGroup="$role" selected="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ToggleButton text="Admin"    toggleGroup="$role" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox spacing="6">
                <Label text="Email Address" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="your.email@example.com"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"/>
            </VBox>

            <HBox alignment="CENTER_LEFT">
                <CheckBox fx:id="rememberMe" text="Remember me"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot Password?"/>
            </HBox>

            <Button fx:id="signInButton" text="Sign In" styleClass="btn,btn-primary" maxWidth="Infinity"/>
            <Label text="OR" styleClass="muted" maxWidth="Infinity" alignment="CENTER"/>
            <Button fx:id="googleButton" text="Continue with Google" styleClass="btn,btn-secondary" maxWidth="Infinity"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an account?" styleClass="muted"/>
                <Hyperlink fx:id="signUpLink" text="Sign Up"/>
            </HBox>
        </VBox>

        <HBox alignment="CENTER" spacing="4">
            <Label text="Need help accessing your account?" styleClass="muted"/>
            <Hyperlink text="Contact Administrator"/>
        </HBox>
    </VBox>
</StackPane>
