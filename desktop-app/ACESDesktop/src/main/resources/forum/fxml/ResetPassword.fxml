<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Reset Password — mirrors web auth/reset-password.blade.php -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           stylesheets="@../css/aces.css" styleClass="root,auth-canvas"
           prefWidth="900" prefHeight="640">
    <VBox alignment="CENTER" maxWidth="448" spacing="16">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        <javafx.scene.image.ImageView fitWidth="90" fitHeight="90" preserveRatio="true"><image><javafx.scene.image.Image url="@../images/logo.jpg"/></image></javafx.scene.image.ImageView>
        <VBox styleClass="auth-card" spacing="16" maxWidth="448">
            <VBox spacing="6">
                <Label text="Email" styleClass="field-label"/>
                <TextField promptText="j.doe@university.ac.ug"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField/>
            </VBox>
            <VBox spacing="6">
                <Label text="Confirm Password" styleClass="field-label"/>
                <PasswordField/>
            </VBox>
            <HBox alignment="CENTER_RIGHT">
                <Button text="RESET PASSWORD" styleClass="btn,btn-dark"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>

