<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Assessment Overview — mirrors web participation/index.blade.php -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820" fx:controller="forum.controllers.StudentAssessmentController">
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT">
            <HBox alignment="CENTER_LEFT" spacing="8">
                    <javafx.scene.image.ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                        <image><javafx.scene.image.Image url="@../images/logo.jpg"/></image>
                    </javafx.scene.image.ImageView>
                    <Label text="ACES" styleClass="brand"/>
                </HBox>
            <Label text="Dashboard"   styleClass="nav-link" onMouseClicked="#onDashboard"/>
            <Label text="Groups"      styleClass="nav-link" onMouseClicked="#onGroups"/>
            <Label text="My Progress" styleClass="nav-link,active"/>
            <Region HBox.hgrow="ALWAYS"/>
            <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                <graphic>
                    <StackPane>
                        <Label text="🔔" style="-fx-font-size: 16px;"/>
                        <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                               style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                               StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                               managed="false" visible="false"/>
                    </StackPane>
                </graphic>
                <items>
                </items>
            </MenuButton>
            <MenuButton styleClass="btn-ghost" text="">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                        <Label fx:id="userNameLabel" text="Signed in"/>
                    </HBox>
                </graphic>
                <items>
                    <MenuItem text="✓  Profile" onAction="#onProfile"/>
                    <MenuItem text="→  Log Out" onAction="#onLogout"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="1120">
                    <VBox spacing="4">
                        <Label text="Assessment Overview" styleClass="h-lg"/>
                        <Label text="Your real forum activity and quiz performance across the courses you've joined." styleClass="muted"/>
                    </VBox>

                    <HBox spacing="24">
                        <!-- Participation metrics -->
                        <VBox styleClass="card-flat" spacing="12" HBox.hgrow="ALWAYS">
                            <Label text="Participation Metrics" styleClass="card-title"/>
                            <Label text="Your Real Engagement Data" styleClass="eyebrow"/>

                            <Label text="Your Activity (Last 7 Days)" styleClass="subtle"/>
                            <HBox fx:id="activityChartBox" spacing="10" alignment="BOTTOM_LEFT" prefHeight="96"/>
                            <HBox fx:id="activityLabelsBox" spacing="10"/>

                            <Region styleClass="divider" prefHeight="1"/>
                            <VBox spacing="4">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Forum Participation" styleClass="muted"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="participationPctLabel" text="—" styleClass="label-strong"/>
                                </HBox>
                                <ProgressBar fx:id="participationProgressBar" progress="0" maxWidth="Infinity"/>
                                <Label fx:id="participationSubLabel" styleClass="subtle" wrapText="true"/>
                            </VBox>
                        </VBox>

                        <!-- Assessment history -->
                        <VBox styleClass="card-flat" spacing="12" HBox.hgrow="ALWAYS">
                            <Label text="Assessment History" styleClass="card-title"/>
                            <VBox fx:id="assessmentHistoryBox" spacing="0"/>
                            <Label fx:id="assessmentEmptyLabel" text="No completed quizzes yet."
                                   styleClass="subtle" wrapText="true" managed="false" visible="false"/>
                        </VBox>
                    </HBox>

                    <!-- Lecturer's remark, or empty state -->
                    <VBox fx:id="remarkBox" styleClass="card-dark" spacing="12" managed="false" visible="false">
                        <Label text="Lecturer's Remark" styleClass="eyebrow-invert"/>
                        <Label fx:id="remarkQuoteLabel" styleClass="body-invert" wrapText="true"/>
                        <Label fx:id="remarkMetaLabel" style="-fx-text-fill:#6b7280; -fx-font-size:11px;"/>
                    </VBox>
                    <VBox fx:id="noRemarkBox" styleClass="card-flat" alignment="CENTER" managed="false" visible="false">
                        <Label text="No lecturer remarks yet — these appear here once a lecturer grades your participation."
                               styleClass="subtle" wrapText="true" style="-fx-text-alignment:center;"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>