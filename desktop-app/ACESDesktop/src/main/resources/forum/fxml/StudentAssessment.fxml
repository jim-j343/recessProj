<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Assessment Overview — mirrors web participation/index.blade.php -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT">
            <Label text="Smart Discussion Forum" styleClass="brand"/>
            <Label text="Dashboard" styleClass="nav-link"/>
            <Label text="Groups" styleClass="nav-link"/>
            <Label text="My Progress" styleClass="nav-link,active"/>
            <Region HBox.hgrow="ALWAYS"/>
            <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="✓  Profile" onAction="#onProfile"/>
                        <MenuItem text="→  Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="1120">
                    <VBox spacing="4">
                        <Label text="Assessment Overview" styleClass="h-lg"/>
                        <Label text="Detailed breakdown of your academic consistency and recent performance." styleClass="muted"/>
                    </VBox>

                    <HBox spacing="24">
                        <!-- Participation metrics -->
                        <VBox styleClass="card-flat" spacing="12" HBox.hgrow="ALWAYS">
                            <Label text="Participation Metrics" styleClass="card-title"/>
                            <Label text="Consistency Score (Last 7 Days)" styleClass="subtle"/>
                            <HBox spacing="10" alignment="BOTTOM_LEFT" prefHeight="120">
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="48"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="78"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="60"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-hi"  prefHeight="96"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="54"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-hi"  prefHeight="108" maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="72"  maxWidth="Infinity"/></VBox>
                            </HBox>
                            <HBox spacing="10">
                                <Label text="Mon" styleClass="subtle" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Tue" styleClass="subtle" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Wed" styleClass="subtle" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Thu" styleClass="subtle" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Fri" styleClass="subtle" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Sat" styleClass="subtle" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Sun" styleClass="subtle" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Region styleClass="divider" prefHeight="1"/>
                            <VBox spacing="4">
                                <HBox alignment="CENTER_LEFT"><Label text="Forum Contribution Quality" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/><Label text="94/100" styleClass="label-strong"/></HBox>
                                <ProgressBar progress="0.94" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4">
                                <HBox alignment="CENTER_LEFT"><Label text="Peer Review Accuracy" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/><Label text="88%" styleClass="label-strong"/></HBox>
                                <ProgressBar progress="0.88" maxWidth="Infinity" style="-fx-accent:#9ca3af;"/>
                            </VBox>
                        </VBox>

                        <!-- Assessment history -->
                        <VBox styleClass="card-flat" spacing="12" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT"><Label text="Assessment History" styleClass="card-title"/><Region HBox.hgrow="ALWAYS"/><Hyperlink text="Download All ↓" styleClass="subtle"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox HBox.hgrow="ALWAYS"><Label text="Advanced React Patterns" styleClass="label-strong"/><Label text="Completed Oct 14, 2024" styleClass="subtle"/></VBox>
                                <Label text="92%" styleClass="label-strong"/>
                                <Label text="+12%" styleClass="badge,badge-success"/>
                            </HBox>
                            <Region styleClass="divider" prefHeight="1"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox HBox.hgrow="ALWAYS"><Label text="Data Structures II" styleClass="label-strong"/><Label text="Completed Oct 08, 2024" styleClass="subtle"/></VBox>
                                <Label text="85%" styleClass="label-strong"/>
                                <Label text="+4%" styleClass="badge,badge-success"/>
                            </HBox>
                            <Region styleClass="divider" prefHeight="1"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox HBox.hgrow="ALWAYS"><Label text="System Architecture" styleClass="label-strong"/><Label text="Completed Sep 29, 2024" styleClass="subtle"/></VBox>
                                <Label text="78%" styleClass="label-strong"/>
                                <Label text="-2%" styleClass="badge,badge-danger"/>
                            </HBox>
                            <Label text="Showing 3 of 12 assessments" styleClass="subtle"/>
                        </VBox>
                    </HBox>

                    <!-- Professor's insight -->
                    <VBox styleClass="card-dark" spacing="12">
                        <Label text="Professor's Insight" styleClass="eyebrow-invert"/>
                        <Label text="&quot;Alex demonstrates exceptional mastery of front-end logic. For the final capstone, focus on optimizing the render cycles in the 'Advanced Patterns' module to achieve top-tier performance benchmarks.&quot;" styleClass="body-invert" wrapText="true"/>
                        <HBox spacing="12">
                            <Button text="SCHEDULE OFFICE HOURS" styleClass="btn" style="-fx-background-color:white; -fx-text-fill:#111827;"/>
                            <Button text="VIEW CURATED RESOURCES" styleClass="btn,btn-ghost-invert"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
