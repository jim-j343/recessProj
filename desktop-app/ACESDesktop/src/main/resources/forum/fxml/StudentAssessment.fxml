<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>

<!-- Assessment Overview — mirrors web participation/index.blade.php -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820" fx:controller="forum.controllers.StudentAssessmentController">
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <javafx.scene.image.ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                    <image><javafx.scene.image.Image url="@../images/logo.jpg"/></image>
                </javafx.scene.image.ImageView>

            </HBox>
            <Label text="Dashboard"   styleClass="nav-link" onMouseClicked="#onDashboard"/>
            <Label text="Groups"      styleClass="nav-link" onMouseClicked="#onGroups"/>
            <Label text="My Progress" styleClass="nav-link,active"/>
            <Label fx:id="navNewTopic" text="New Topic" styleClass="nav-link" onMouseClicked="#onNewTopic" managed="false" visible="false"/>
            <Region HBox.hgrow="ALWAYS"/>
            <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                <graphic>
                    <StackPane>
                        <Label text="🔔" style="-fx-font-size: 16px;"/>
                        <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                               style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                               StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                               managed="false" visible="false"/>
                    </StackPane>
                </graphic>
                <items>
                </items>
            </MenuButton>
            <MenuButton styleClass="btn-ghost" text="">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                        <Label fx:id="userNameLabel" text="Signed in"/>
                    </HBox>
                </graphic>
                <items>
                    <MenuItem text="Profile" onAction="#onProfile">
                        <graphic>
                            <javafx.scene.layout.StackPane prefHeight="30" prefWidth="40">
                                <javafx.scene.shape.SVGPath content="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M9 12l2 2 4-4" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                            </javafx.scene.layout.StackPane>
                        </graphic>
                    </MenuItem>
                    <MenuItem text="Log Out" onAction="#onLogout">
                        <graphic>
                            <javafx.scene.layout.StackPane prefHeight="30" prefWidth="40">
                                <javafx.scene.shape.SVGPath content="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                            </javafx.scene.layout.StackPane>
                        </graphic>
                    </MenuItem>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50" style="-fx-background-color: transparent;">
            <HBox spacing="0" alignment="TOP_LEFT">



                <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
                <VBox alignment="TOP_CENTER" HBox.hgrow="ALWAYS" style="-fx-padding: 32;">
                    <VBox spacing="24" maxWidth="1120">

                        <VBox spacing="4">
                            <Label text="Assessment Overview" styleClass="h-lg"/>
                            <Label text="Your real forum activity and quiz performance across the courses you've joined." styleClass="muted"/>
                        </VBox>

                        <HBox spacing="24">

                            <!-- Participation metrics -->
                            <VBox styleClass="card-flat" spacing="12" HBox.hgrow="ALWAYS" prefWidth="540">
                                <VBox spacing="4">
                                    <Label text="Participation Metrics" styleClass="card-title" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                                    <Label text="YOUR REAL ENGAGEMENT DATA" styleClass="subtle" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                                </VBox>
                                <Label text="Your Activity (Last 7 Days)" styleClass="muted" style="-fx-padding: 10 0 0 0;"/>
                                <HBox fx:id="activityChartBox" spacing="10" alignment="BOTTOM_LEFT" prefHeight="140" style="-fx-padding: 0 10 0 10;"/>
                                <HBox fx:id="activityLabelsBox" spacing="10" style="-fx-padding: 0 10 0 10;"/>
                                <Region prefHeight="1" style="-fx-background-color: transparent;"/>
                                <VBox spacing="4" style="-fx-padding: 10 0 0 0;">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Forum Participation" styleClass="muted" style="-fx-text-fill: #334155;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="participationPctLabel" text="—" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <StackPane fx:id="participationBarPane" alignment="CENTER_LEFT" minHeight="6" prefHeight="6" maxHeight="6">
                                        <Region style="-fx-background-color: #e2e8f0; -fx-background-radius: 999;" minHeight="6" prefHeight="6" maxHeight="6" maxWidth="Infinity"/>
                                        <Region fx:id="participationBarFill" style="-fx-background-color: #1e293b; -fx-background-radius: 999;" prefWidth="0" maxWidth="0" minHeight="6" prefHeight="6" maxHeight="6"/>
                                    </StackPane>
                                    <Label fx:id="participationSubLabel" text="Loading..." styleClass="subtle"/>
                                </VBox>
                            </VBox>

                            <!-- Assessment history -->
                            <VBox styleClass="card-flat" spacing="12" HBox.hgrow="ALWAYS" prefWidth="620">
                                <Label text="Assessment History" styleClass="card-title" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                                <HBox spacing="16" alignment="CENTER_LEFT">

                                    <Label text="QUIZ"
                                        styleClass="subtle"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>

                                    <Label text="SCORE"
                                        styleClass="subtle"
                                        prefWidth="90"
                                        minWidth="90"
                                        maxWidth="90"
                                        alignment="CENTER"/>

                                    <Label text="VS PEER AVG"
                                        styleClass="subtle"
                                        prefWidth="120"
                                        minWidth="120"
                                        maxWidth="120"
                                        alignment="CENTER"/>

                                </HBox>
                                <Region styleClass="divider" prefHeight="1"/>
                                <VBox fx:id="assessmentHistoryBox" spacing="0"/>
                            </VBox>
                        </HBox>

                        <!-- Lecturer's remark: dynamic from API -->
                        <VBox spacing="12" style="-fx-background-color: #0f172a; -fx-background-radius: 8; -fx-padding: 26 24 26 24;">
                            <Label text="Lecturer's Remark" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="remarkLabel" text="No remarks yet." wrapText="true" style="-fx-text-fill: #cbd5e1; -fx-font-style: italic; -fx-font-size: 14px;"/>
                            <Label fx:id="remarkMetaLabel" text="" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
    <bottom>
        <fx:include source="Footer.fxml"/>
    </bottom>
</BorderPane>