<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Assessment Overview — mirrors web participation/index.blade.php -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820" fx:controller="forum.controllers.StudentAssessmentController">
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT">
            <HBox alignment="CENTER_LEFT" spacing="8">
                    <javafx.scene.image.ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                        <image><javafx.scene.image.Image url="@../images/logo.jpg"/></image>
                    </javafx.scene.image.ImageView>
                    <Label text="ACES" styleClass="brand"/>
                </HBox>
            <Label text="Dashboard"   styleClass="nav-link" onMouseClicked="#onDashboard"/>
            <Label text="Groups"      styleClass="nav-link" onMouseClicked="#onGroups"/>
            <Label text="My Progress" styleClass="nav-link,active"/>
            <Label fx:id="navNewTopic" text="New Topic" styleClass="nav-link" onMouseClicked="#onNewTopic" managed="false" visible="false"/>
            <Region HBox.hgrow="ALWAYS"/>
            <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                <graphic>
                    <StackPane>
                        <Label text="🔔" style="-fx-font-size: 16px;"/>
                        <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                               style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                               StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                               managed="false" visible="false"/>
                    </StackPane>
                </graphic>
                <items>
                </items>
            </MenuButton>
            <MenuButton styleClass="btn-ghost" text="">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                        <Label fx:id="userNameLabel" text="Signed in"/>
                    </HBox>
                </graphic>
                <items>
                    <MenuItem text="Profile" onAction="#onProfile">
                            <graphic>
                                <javafx.scene.layout.StackPane prefHeight="30" prefWidth="40">
                                    <javafx.scene.shape.SVGPath content="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M9 12l2 2 4-4" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                                </javafx.scene.layout.StackPane>
                            </graphic>
                        </MenuItem>
                        <MenuItem text="Log Out" onAction="#onLogout">
                            <graphic>
                                <javafx.scene.layout.StackPane prefHeight="30" prefWidth="40">
                                    <javafx.scene.shape.SVGPath content="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                                </javafx.scene.layout.StackPane>
                            </graphic>
                        </MenuItem>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="1120">
                    <VBox spacing="4">
                        <Label text="Assessment Overview" styleClass="h-lg"/>
                        <Label text="Your real forum activity and quiz performance across the courses you've joined." styleClass="muted"/>
                    </VBox>

                    <HBox spacing="24">
                        <!-- Participation metrics -->
                        <VBox styleClass="card-flat" spacing="12" HBox.hgrow="ALWAYS" prefWidth="500">
                            <VBox spacing="4">
                                <Label text="Participation Metrics" styleClass="card-title" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                                <Label text="YOUR REAL ENGAGEMENT DATA" styleClass="subtle" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-text-transform: uppercase;"/>
                            </VBox>
                            <Label text="Your Activity (Last 7 Days)" styleClass="muted" style="-fx-padding: 10 0 0 0;"/>
                            <HBox spacing="10" alignment="BOTTOM_LEFT" prefHeight="140" style="-fx-padding: 0 10 0 10;">
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar" style="-fx-background-color: #e2e8f0; -fx-background-radius: 4 4 0 0;" prefHeight="6"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar" style="-fx-background-color: #e2e8f0; -fx-background-radius: 4 4 0 0;" prefHeight="6"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar" style="-fx-background-color: #e2e8f0; -fx-background-radius: 4 4 0 0;" prefHeight="6"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar" style="-fx-background-color: #e2e8f0; -fx-background-radius: 4 4 0 0;" prefHeight="6"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar" style="-fx-background-color: #e2e8f0; -fx-background-radius: 4 4 0 0;" prefHeight="6"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar" style="-fx-background-color: #e2e8f0; -fx-background-radius: 4 4 0 0;" prefHeight="6"  maxWidth="Infinity"/></VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar" style="-fx-background-color: #1e293b; -fx-background-radius: 4 4 0 0;" prefHeight="100" maxWidth="Infinity"/></VBox>
                            </HBox>
                            <HBox spacing="10" style="-fx-padding: 0 10 0 10;">
                                <Label text="Wed" styleClass="subtle" style="-fx-font-size: 11px;" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Thu" styleClass="subtle" style="-fx-font-size: 11px;" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Fri" styleClass="subtle" style="-fx-font-size: 11px;" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Sat" styleClass="subtle" style="-fx-font-size: 11px;" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Sun" styleClass="subtle" style="-fx-font-size: 11px;" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Mon" styleClass="subtle" style="-fx-font-size: 11px;" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                <Label text="Tue" styleClass="subtle" style="-fx-font-size: 11px;" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Region styleClass="divider" prefHeight="1" style="-fx-background-color: transparent;"/>
                            <VBox spacing="4" style="-fx-padding: 10 0 0 0;">
                                <HBox alignment="CENTER_LEFT"><Label text="Forum Participation" styleClass="muted" style="-fx-text-fill: #334155;"/><Region HBox.hgrow="ALWAYS"/><Label text="90%" styleClass="label-strong" style="-fx-font-size: 14px; -fx-font-weight: bold;"/></HBox>
                                <ProgressBar progress="0.9" maxWidth="Infinity" style="-fx-accent: #1e293b; -fx-control-inner-background: #e2e8f0;"/>
                                <Label text="9 replies out of 13 total posts (9/10 replies counted — 10 or more reaches 100%)" styleClass="subtle" style="-fx-font-size: 11px;"/>
                            </VBox>
                        </VBox>

                        <!-- Assessment history -->
                        <VBox styleClass="card-flat" spacing="12" HBox.hgrow="ALWAYS" prefWidth="600">
                            <Label text="Assessment History" styleClass="card-title" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                            
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="QUIZ" styleClass="subtle" style="-fx-font-size: 11px;" prefWidth="300" HBox.hgrow="ALWAYS"/>
                                <Label text="SCORE" styleClass="subtle" style="-fx-font-size: 11px;" prefWidth="80" alignment="CENTER"/>
                                <Label text="VS PEER AVG" styleClass="subtle" style="-fx-font-size: 11px;" prefWidth="100" alignment="CENTER"/>
                            </HBox>
                            <Region styleClass="divider" prefHeight="1" style="-fx-background-color: transparent;"/>
                            
                            <!-- Row 1 -->
                            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8 0;">
                                <VBox prefWidth="300" HBox.hgrow="ALWAYS">
                                    <Label text="Normalization &amp; Keys" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                    <Label text="Completed 18 Jul 2026" styleClass="subtle" style="-fx-font-size: 11px;"/>
                                </VBox>
                                <Label text="66.7%" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" prefWidth="80" alignment="CENTER"/>
                                <HBox prefWidth="100" alignment="CENTER">
                                    <Label text="-6.6%" style="-fx-text-fill: #ef4444; -fx-background-color: #fee2e2; -fx-padding: 2 6; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </HBox>
                            </HBox>
                            
                            <!-- Row 2 -->
                            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8 0;">
                                <VBox prefWidth="300" HBox.hgrow="ALWAYS">
                                    <Label text="Root-Finding Methods" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                    <Label text="Completed 17 Jul 2026" styleClass="subtle" style="-fx-font-size: 11px;"/>
                                </VBox>
                                <Label text="66.7%" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" prefWidth="80" alignment="CENTER"/>
                                <HBox prefWidth="100" alignment="CENTER">
                                    <Label text="-7.4%" style="-fx-text-fill: #ef4444; -fx-background-color: #fee2e2; -fx-padding: 2 6; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </HBox>
                            </HBox>
                            
                            <!-- Row 3 -->
                            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8 0;">
                                <VBox prefWidth="300" HBox.hgrow="ALWAYS">
                                    <Label text="SDLC Fundamentals Quiz" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                    <Label text="Completed 16 Jul 2026" styleClass="subtle" style="-fx-font-size: 11px;"/>
                                </VBox>
                                <Label text="75%" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" prefWidth="80" alignment="CENTER"/>
                                <HBox prefWidth="100" alignment="CENTER">
                                    <Label text="-2.5%" style="-fx-text-fill: #ef4444; -fx-background-color: #fee2e2; -fx-padding: 2 6; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </HBox>
                            </HBox>
                            
                            <!-- Row 4 -->
                            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8 0;">
                                <VBox prefWidth="300" HBox.hgrow="ALWAYS">
                                    <Label text="OOP vs FP Basics" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                    <Label text="Completed 15 Jul 2026" styleClass="subtle" style="-fx-font-size: 11px;"/>
                                </VBox>
                                <Label text="100%" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" prefWidth="80" alignment="CENTER"/>
                                <HBox prefWidth="100" alignment="CENTER">
                                    <Label text="+6.7%" style="-fx-text-fill: #10b981; -fx-background-color: #d1fae5; -fx-padding: 2 6; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </HBox>
                            </HBox>
                            
                            <!-- Row 5 -->
                            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8 0;">
                                <VBox prefWidth="300" HBox.hgrow="ALWAYS">
                                    <Label text="REST API Concepts" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                    <Label text="Completed 13 Jul 2026" styleClass="subtle" style="-fx-font-size: 11px;"/>
                                </VBox>
                                <Label text="66.7%" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" prefWidth="80" alignment="CENTER"/>
                                <HBox prefWidth="100" alignment="CENTER">
                                    <Label text="-6.6%" style="-fx-text-fill: #ef4444; -fx-background-color: #fee2e2; -fx-padding: 2 6; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </HBox>
                            </HBox>

                        </VBox>
                    </HBox>

                    <!-- Professor's insight -->
                    <VBox styleClass="card-dark" spacing="12" style="-fx-background-color: #0f172a; -fx-background-radius: 8; -fx-padding: 24;">
                        <Label text="Lecturer's Remark" styleClass="eyebrow-invert" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="&quot;Consistently helpful replies, especially on the SDLC thread. Keep it up.&quot;"
                            styleClass="body-invert" wrapText="true" style="-fx-text-fill: #cbd5e1; -fx-font-style: italic; -fx-font-size: 14px;"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>


