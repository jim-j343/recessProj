<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.LecturerDashboardController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
<javafx.scene.image.ImageView fitWidth="48" fitHeight="48" preserveRatio="true"><image><javafx.scene.image.Image url="@../images/logo.jpg"/></image></javafx.scene.image.ImageView>
                <Label text="Dashboard"   styleClass="nav-link,active"/>
                <Label text="Groups"      styleClass="nav-link" onMouseClicked="#onGroups"/>
                <Label text="New Topic"   styleClass="nav-link" onMouseClicked="#onNewTopic"/>
                <Label text="Quiz Center" styleClass="nav-link" onMouseClicked="#onQuizCenter"/>
                <Label text="Grading"     styleClass="nav-link" onMouseClicked="#onGrading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                            <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                                   style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                                   StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                                   managed="false" visible="false"/>
                        </StackPane>
                    </graphic>
                    <items>
                    </items>
                </MenuButton>
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text=""/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="✓  Profile" onAction="#onProfile"/>
                        <MenuItem text="→  Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <Label text="Lecturer Dashboard" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ New Quiz" styleClass="btn,btn-primary" onAction="#onQuizCenter"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="1120">

                    <!-- Stats -->
                    <HBox spacing="16">
                        <VBox styleClass="card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="quizCountLabel"
                                   style="-fx-text-fill:#4f46e5; -fx-font-size:26px; -fx-font-weight:bold;"
                                   text="—"/>
                            <Label text="Quizzes created" styleClass="muted"/>
                        </VBox>
                        <VBox styleClass="card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="groupCountLabel"
                                   style="-fx-text-fill:#16a34a; -fx-font-size:26px; -fx-font-weight:bold;"
                                   text="—"/>
                            <Label text="Groups joined" styleClass="muted"/>
                        </VBox>
                        <VBox styleClass="card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="topicCountLabel"
                                   style="-fx-text-fill:#374151; -fx-font-size:26px; -fx-font-weight:bold;"
                                   text="—"/>
                            <Label text="Topics created" styleClass="muted"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="24">
                        <!-- My quizzes -->
                        <VBox styleClass="card" spacing="0" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
                                <Label text="My Quizzes" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Hyperlink text="+ New" onAction="#onQuizCenter" style="-fx-text-fill: #4f46e5; -fx-font-weight: 600; -fx-font-size: 13px; -fx-border-color: transparent;"/>
                            </HBox>
                            <VBox fx:id="quizListBox" spacing="0"/>
                            <Label fx:id="noQuizzesLabel" text="No quizzes yet. Create your first one."
                                   styleClass="muted" managed="false" visible="false"/>
                        </VBox>

                        <!-- Quick actions -->
                        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                            <Label text="Quick Actions" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                            <!-- Each button: left-aligned icon + text, matching web -->
                            <Button styleClass="btn,btn-secondary" maxWidth="Infinity" onAction="#onQuizCenter">
                                <graphic>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="✏" style="-fx-font-size: 14px; -fx-text-fill: #4f46e5;"/>
                                        <Label text="Create a new quiz" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button styleClass="btn,btn-secondary" maxWidth="Infinity" onAction="#onNewTopic">
                                <graphic>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="💬" style="-fx-font-size: 14px;"/>
                                        <Label text="Post a new topic" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button styleClass="btn,btn-secondary" maxWidth="Infinity" onAction="#onForum">
                                <graphic>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="👁" style="-fx-font-size: 14px;"/>
                                        <Label text="View forum" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button styleClass="btn,btn-secondary" maxWidth="Infinity" onAction="#onGrading">
                                <graphic>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="🏆" style="-fx-font-size: 14px;"/>
                                        <Label text="Award participation marks" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </VBox>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
