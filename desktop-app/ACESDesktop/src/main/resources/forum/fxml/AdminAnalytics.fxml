<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<!-- ACES - Admin Analytics Overview  (UI only) -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <left>
        <VBox styleClass="sidebar" spacing="2">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="24" left="8"/></padding>
                <ImageView fitWidth="34" fitHeight="34" preserveRatio="true"><image><Image url="@../images/aces-logo.png"/></image></ImageView>
                <VBox><Label text="ACES" styleClass="brand-name"/><Label text="Admin Console" styleClass="brand-sub"/></VBox>
            </HBox>
            <Label text="OVERVIEW" styleClass="nav-section"/>
            <Button text="Analytics"   styleClass="nav-item,active" maxWidth="Infinity"/>
            <Button text="Discussions" styleClass="nav-item" maxWidth="Infinity"/>
            <Button text="Quiz Center" styleClass="nav-item" maxWidth="Infinity"/>
            <Label text="GOVERNANCE" styleClass="nav-section"/>
            <Button text="Compliance"  styleClass="nav-item" maxWidth="Infinity"/>
            <Button text="Members"      styleClass="nav-item" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="12"/></padding>
                <Label text="SJ" styleClass="brand-logo" minWidth="34" minHeight="34"/>
                <VBox><Label text="Dr. Sarah Jenkins" styleClass="label-strong"/><Label text="Lead Administrator" styleClass="brand-sub"/></VBox>
            </HBox>
        </VBox>
    </left>
    <center>
        <VBox>
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label text="Analytics Overview" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField promptText="Search metrics..." prefWidth="300"/>
                <Button text="Filter" styleClass="btn,btn-secondary"/>
            </HBox>
            <ScrollPane fitToWidth="true" styleClass="content">
                <VBox spacing="24">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Academic Insights" styleClass="h-lg"/>
                            <Label text="Real-time performance metrics for the current semester." styleClass="muted"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <ComboBox promptText="Advanced Calculus II"/>
                            <Button text="Last 7 Days" styleClass="btn,btn-primary"/>
                        </HBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox styleClass="card" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="ACTIVE MEMBERS" styleClass="eyebrow"/>
                            <Label text="4,218" styleClass="metric-value"/>
                            <Label text="Up 6.2% vs last week" styleClass="muted"/>
                        </VBox>
                        <VBox styleClass="card" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="THREADS POSTED" styleClass="eyebrow"/>
                            <Label text="1,046" styleClass="metric-value"/>
                            <Label text="Up 3.1%" styleClass="muted"/>
                        </VBox>
                        <VBox styleClass="card" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="AVG. PARTICIPATION" styleClass="eyebrow"/>
                            <Label text="84%" styleClass="metric-value"/>
                            <Label text="Up 12%" styleClass="muted"/>
                        </VBox>
                        <VBox styleClass="card" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="FLAGGED ACCOUNTS" styleClass="eyebrow"/>
                            <Label text="08" styleClass="metric-value"/>
                            <Label text="Down 2 resolved" styleClass="muted"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="24">
                        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <VBox><Label text="Post Volume Traffic" styleClass="card-title"/><Label text="Engagement velocity across all modules" styleClass="muted"/></VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Live Traffic" styleClass="badge,badge-accent"/>
                            </HBox>
                            <VBox spacing="8">
                                <HBox spacing="12" alignment="BOTTOM_LEFT" prefHeight="200">
                                    <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="70"  maxWidth="Infinity"/></VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="104" maxWidth="Infinity"/></VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="88"  maxWidth="Infinity"/></VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-hi"  prefHeight="160" maxWidth="Infinity"/></VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="120" maxWidth="Infinity"/></VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-hi"  prefHeight="190" maxWidth="Infinity"/></VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="BOTTOM_CENTER"><Region styleClass="bar,bar-dim" prefHeight="140" maxWidth="Infinity"/></VBox>
                                </HBox>
                                <HBox spacing="12">
                                    <Label text="Mon" styleClass="muted" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                    <Label text="Tue" styleClass="muted" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                    <Label text="Wed" styleClass="muted" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                    <Label text="Thu" styleClass="muted" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                    <Label text="Fri" styleClass="muted" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                    <Label text="Sat" styleClass="muted" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                    <Label text="Sun" styleClass="muted" maxWidth="Infinity" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>
                        </VBox>
                        <VBox spacing="16" prefWidth="280" minWidth="280">
                            <VBox styleClass="card" spacing="4">
                                <Label text="OPERATIONAL" styleClass="eyebrow"/>
                                <Label text="System Sync" styleClass="muted"/>
                                <Label text="99.8%" styleClass="metric-value"/>
                            </VBox>
                            <VBox styleClass="card" spacing="4">
                                <Label text="STABLE" styleClass="eyebrow"/>
                                <Label text="Offline Reliability" styleClass="muted"/>
                                <Label text="Active" styleClass="h-md"/>
                                <Label text="Local caching active for 4.2k users" styleClass="muted" wrapText="true"/>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
