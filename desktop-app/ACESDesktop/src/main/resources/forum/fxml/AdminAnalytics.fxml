<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Admin Analytics — mirrors web admin/analytics.blade.php -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.AdminAnalyticsController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT">
            <Label text="Smart Discussion Forum" styleClass="brand"/>
            <Label text="Dashboard" onMouseClicked="#onDashboard" styleClass="nav-link"/>
            <Label text="Groups" onMouseClicked="#onGroups" styleClass="nav-link"/>
            <Label text="Members" onMouseClicked="#onMembers" styleClass="nav-link"/>
            <Label text="Analytics" onMouseClicked="#onAnalytics" styleClass="nav-link,active"/>
            <Region HBox.hgrow="ALWAYS"/>
            <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                            <Label text="3" styleClass="badge,badge-danger" style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;" StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"/>
                        </StackPane>
                    </graphic>
                    <items>
                        <MenuItem text="System Maintenance at Midnight" styleClass="muted"/>
                        <MenuItem text="New user signups waiting approval" styleClass="muted"/>
                        <MenuItem text="Database backup successful" styleClass="muted"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Mark all as read"/>
                    </items>
                </MenuButton>

                <!-- Profile Dropdown -->
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="??"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="Profile" onAction="#onProfile"/>
                        <MenuItem text="Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="1152">

                    <!-- Heading row -->
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Academic Insights" styleClass="h-lg"/>
                            <Label text="Real-time performance metrics for the current semester." styleClass="muted"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="12" alignment="CENTER_RIGHT">
                            <ComboBox promptText="Advanced Calculus II"/>
                            <Button text="Last 7 Days" styleClass="btn,btn-dark"/>
                        </HBox>
                    </HBox>

                    <!-- Stat cards -->
                    <HBox spacing="16">
                        <VBox styleClass="card-flat" spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="TOTAL MEMBERS" styleClass="eyebrow"/>
                            <Label fx:id="totalMembersLabel" text="-" styleClass="metric-value"/>
                            <Label text="Live update" style="-fx-text-fill:#16a34a; -fx-font-size:12px; -fx-font-weight:600;"/>
                        </VBox>
                        <VBox styleClass="card-flat" spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="ACTIVE THIS WEEK" styleClass="eyebrow"/>
                            <Label fx:id="activeThisWeekLabel" text="-" styleClass="metric-value"/>
                            <Label fx:id="activeThisWeekMetaLabel" text="-" styleClass="subtle"/>
                        </VBox>
                        <VBox styleClass="card-flat" spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="WARNINGS ISSUED" styleClass="eyebrow"/>
                            <Label fx:id="warningsThisWeekLabel" text="-" styleClass="metric-value"/>
                            <Label text="Live update" style="-fx-text-fill:#ca8a04; -fx-font-size:12px; -fx-font-weight:600;"/>
                        </VBox>
                        <VBox styleClass="card-flat" spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="BLACKLISTED" styleClass="eyebrow"/>
                            <Label fx:id="activeBlacklistsLabel" text="-" styleClass="metric-value"/>
                            <Label text="Active restrictions" style="-fx-text-fill:#ef4444; -fx-font-size:12px; -fx-font-weight:600;"/>
                        </VBox>
                    </HBox>

                    <!-- Chart + system status -->
                    <HBox spacing="24">
                        <VBox styleClass="card-flat" spacing="16" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <VBox><Label text="Post Volume Traffic" styleClass="card-title"/><Label text="Engagement across all modules this week" styleClass="subtle"/></VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="● Live" style="-fx-text-fill:#16a34a; -fx-font-size:12px; -fx-font-weight:600;"/>
                            </HBox>
                            <VBox fx:id="postVolumeBox" spacing="8"/>
                        </VBox>

                        <VBox spacing="16" prefWidth="300" minWidth="300">
                            <VBox styleClass="card-flat" spacing="4">
                                <Label text="GROUP AVERAGE PERFORMANCE" styleClass="eyebrow"/>
                                <VBox fx:id="groupPerformanceBox" spacing="6"/>
                            </VBox>
                            <VBox styleClass="card-flat" spacing="4">
                                <Label text="GROUP ACTIVITY" styleClass="eyebrow"/>
                                <VBox fx:id="groupActivityBox" spacing="6"/>
                            </VBox>
                            <Label fx:id="statusLabel" text="Loading..." managed="false" visible="false" styleClass="muted" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <!-- Trending + activity -->
                    <HBox spacing="24">
                        <VBox styleClass="card-flat" spacing="16" HBox.hgrow="ALWAYS">
                            <VBox><Label text="Groups" styleClass="card-title"/><Label text="Topic count per group" styleClass="subtle"/></VBox>
                            <FlowPane fx:id="groupsBox" hgap="8" vgap="8"/>
                        </VBox>

                        <VBox styleClass="card-flat" spacing="16" prefWidth="360" minWidth="360">
                            <HBox alignment="CENTER_LEFT"><Label text="Recent Activity" styleClass="card-title"/><Region HBox.hgrow="ALWAYS"/><Hyperlink text="View all" styleClass="subtle"/></HBox>
                            <VBox fx:id="recentActivityBox" spacing="8"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
