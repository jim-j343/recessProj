<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.StudentDashboardController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
<javafx.scene.image.ImageView fitWidth="48" fitHeight="48" preserveRatio="true"><image><javafx.scene.image.Image url="@../images/logo.jpg"/></image></javafx.scene.image.ImageView>
                <Label text="Dashboard" styleClass="nav-link,active" onMouseClicked="#onDashboard"/>
                <Label text="Groups"    styleClass="nav-link"        onMouseClicked="#onGroups"/>
                <Label fx:id="navMyProgress" text="My Progress" styleClass="nav-link" onMouseClicked="#onMyProgress" managed="false" visible="false"/>
                <Label fx:id="navNewTopic"   text="New Topic"   styleClass="nav-link" onMouseClicked="#onNewTopic"   managed="false" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                            <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                                   style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                                   StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                                   managed="false" visible="false"/>
                        </StackPane>
                    </graphic>
                    <items>
                    </items>
                </MenuButton>
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="Profile" onAction="#onProfile">
                            <graphic>
                                <javafx.scene.layout.StackPane prefHeight="30" prefWidth="40">
                                    <javafx.scene.shape.SVGPath content="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M9 12l2 2 4-4" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                                </javafx.scene.layout.StackPane>
                            </graphic>
                        </MenuItem>
                        <MenuItem text="Log Out" onAction="#onLogout">
                            <graphic>
                                <javafx.scene.layout.StackPane prefHeight="30" prefWidth="40">
                                    <javafx.scene.shape.SVGPath content="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                                </javafx.scene.layout.StackPane>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label fx:id="welcomeLabel" styleClass="page-title"/>
                    <Label text="Here's where your progress, grades, and quizzes stand today." styleClass="subtle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Go to Forum" styleClass="btn,btn-primary" onAction="#onForum"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="1120">

                    <!-- Quiz alert -->
                    <HBox fx:id="quizAlertBox" styleClass="alert-gray" alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="quizAlertIcon" style="-fx-text-fill:#4b5563; -fx-font-size:18px;"/>
                        <VBox>
                            <Label fx:id="quizAlertTitle" styleClass="label-strong"/>
                            <Label fx:id="quizAlertSub"   styleClass="subtle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="takeQuizBtn" text="Take Quiz"
                                styleClass="btn,btn-primary"
                                onAction="#onTakeQuiz"
                                managed="false" visible="false"/>
                    </HBox>

                    <!-- Stats -->
                    <Label text="PROGRESS &amp; GENERAL ASSESSMENT" styleClass="eyebrow"/>
                    <HBox spacing="16">
                        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="QUIZ PROGRESS" styleClass="eyebrow"/>
                            <Label fx:id="quizProgressLabel" text="—" styleClass="metric-value"/>
                            <ProgressBar fx:id="quizProgressBar" progress="0" maxWidth="Infinity"/>
                            <Label fx:id="quizProgressSub" styleClass="subtle" wrapText="true"/>
                        </VBox>
                        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PARTICIPATION SCORE" styleClass="eyebrow"/>
                            <Label fx:id="participationLabel" text="—" styleClass="metric-value"/>
                            <VBox fx:id="participationByGroupBox" spacing="4"/>
                        </VBox>
                        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="COMMUNITY STANDING" styleClass="eyebrow"/>
                            <Label fx:id="standingLabel" styleClass="badge,badge-success" text="Active"/>
                            <Label fx:id="standingSub" styleClass="subtle" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <!-- Recent quiz results -->
                    <VBox styleClass="card" spacing="0">
                        <HBox alignment="CENTER_LEFT">
                            <padding><Insets bottom="12"/></padding>
                            <Label text="Recent Quiz Results" styleClass="card-title"/>
                        </HBox>
                        <VBox fx:id="resultsBox" spacing="0"/>
                        <Label fx:id="noResultsLabel" text="No quiz results yet." styleClass="muted"
                               managed="false" visible="false"/>
                    </VBox>

                    <!-- Latest and Recommended Topics -->
                    <HBox spacing="16">
                        <VBox fx:id="latestTopicBox" styleClass="card" spacing="6" HBox.hgrow="ALWAYS" style="-fx-cursor: hand;">
                            <Label text="LATEST TOPIC" styleClass="eyebrow"/>
                            <Label fx:id="latestTopicTitle" text="No topics yet" styleClass="label-strong"/>
                            <Label fx:id="latestTopicMeta" styleClass="subtle" wrapText="true"/>
                        </VBox>
                        <VBox fx:id="recommendedTopicBox" styleClass="card" spacing="6" HBox.hgrow="ALWAYS" style="-fx-cursor: hand;">
                            <Label text="RECOMMENDED TOPIC" styleClass="eyebrow"/>
                            <Label fx:id="recommendedTopicTitle" text="You're all caught up" styleClass="label-strong"/>
                            <Label fx:id="recommendedTopicMeta" styleClass="subtle" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <!-- Logout -->
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Log Out" styleClass="btn,btn-ghost" onAction="#onLogout">
                            <graphic>
                                <javafx.scene.shape.SVGPath content="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                            </graphic>
                        </Button>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
