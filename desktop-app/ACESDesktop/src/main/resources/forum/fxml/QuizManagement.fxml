<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.QuizManagementController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
<HBox alignment="CENTER_LEFT" spacing="8">
    <javafx.scene.image.ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
        <image><javafx.scene.image.Image url="@../images/logo.jpg"/></image>
    </javafx.scene.image.ImageView>
</HBox>
                <Label text="Dashboard"   styleClass="nav-link" onMouseClicked="#onDashboard"/>
                <Label text="Groups"      styleClass="nav-link" onMouseClicked="#onGroups"/>
                <Label text="New Topic"   styleClass="nav-link" onMouseClicked="#onNewTopic"/>
                <Label text="Quiz Center" styleClass="nav-link,active"/>
                <Label text="Grading"     styleClass="nav-link" onMouseClicked="#onGrading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Notification bell — populated dynamically from backend -->
                <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                            <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                                   style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                                   StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                                   managed="false" visible="false"/>
                        </StackPane>
                    </graphic>
                    <items>
                        <!-- Items populated by NavbarHelper.loadNotifications() -->
                    </items>
                </MenuButton>
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="Profile" onAction="#onProfile">
                            <graphic>
                                <javafx.scene.layout.StackPane prefHeight="30" prefWidth="40">
                                    <javafx.scene.shape.SVGPath content="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M9 12l2 2 4-4" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                                </javafx.scene.layout.StackPane>
                            </graphic>
                        </MenuItem>
                        <MenuItem text="Log Out" onAction="#onLogout">
                            <graphic>
                                <javafx.scene.layout.StackPane prefHeight="30" prefWidth="40">
                                    <javafx.scene.shape.SVGPath content="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9" fill="transparent" stroke="#94a3b8" strokeWidth="1.7" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                                </javafx.scene.layout.StackPane>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <Label text="Create Quiz" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Back to Dashboard" styleClass="btn,btn-secondary"
                        onAction="#onDashboard"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-50">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="768">

                    <Label fx:id="statusLabel" styleClass="muted"
                           managed="false" visible="false"/>

                    <!-- General details -->
                    <VBox styleClass="card-flat" spacing="16">
                        <Label text="⚙ General Details" styleClass="card-title"/>

                        <VBox spacing="6">
                            <Label text="QUIZ TITLE *" styleClass="eyebrow"/>
                            <TextField fx:id="titleField"
                                       promptText="e.g. Advanced Macroeconomics Midterm"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="GROUP *" styleClass="eyebrow"/>
                            <ComboBox fx:id="groupCombo"
                                      promptText="-- Select a group --"
                                      maxWidth="Infinity"/>
                        </VBox>

                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="START DATE &amp; TIME *" styleClass="eyebrow"/>
                                <TextField fx:id="startTimeField"
                                           promptText="2026-07-20T10:00:00"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="DURATION (MINUTES) *" styleClass="eyebrow"/>
                                <TextField fx:id="durationField" text="30"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="6">
                            <Label text="STUDENT CATEGORY" styleClass="eyebrow"/>
                            <TextField fx:id="categoryField"
                                       promptText="e.g. Year 2 Computer Science"/>
                        </VBox>
                    </VBox>

                    <!-- Questions -->
                    <VBox styleClass="card-flat" spacing="16">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="📝 Questions" styleClass="card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Add Question" styleClass="btn,btn-primary"
                                    onAction="#onAddQuestion"/>
                        </HBox>
                        <VBox fx:id="questionsBox" spacing="16"/>
                    </VBox>

                    <!-- Submit -->
                    <HBox spacing="16">
                        <Button text="🚀 Publish Quiz" styleClass="btn,btn-dark"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                onAction="#onPublish"/>
                        <Button text="💾 Save as Draft" styleClass="btn,btn-outline"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                onAction="#onSaveDraft"/>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="Footer.fxml"/>
    </bottom>
</BorderPane>
