<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>
<?import forum.ui.RevealPasswordField?>
<?import forum.ui.IconTextField?>

<!-- ACES · Register / Onboarding  (UI only) -->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="forum.controllers.RegisterController"
           stylesheets="@../css/aces.css" styleClass="root,auth" style="-fx-background-color: white;"
           prefWidth="900" prefHeight="700">
    <fx:define><ToggleGroup fx:id="role"/></fx:define>
    <VBox alignment="TOP_CENTER" maxWidth="440" spacing="20">
        <padding><Insets top="40" right="16" bottom="40" left="16"/></padding>

        <VBox alignment="CENTER" spacing="6">
            <ImageView fitWidth="52" fitHeight="52" preserveRatio="true"><image><Image url="@../images/aces-logo.png"/></image></ImageView>
            <Label text="Create Account" styleClass="display"/>
            <Label text="Join the ACES platform to get started" styleClass="muted"/>
        </VBox>

        <VBox styleClass="auth-surface" spacing="16" maxWidth="440">
            <VBox spacing="6">
                <Label text="Select Role" styleClass="field-label"/>
                <HBox styleClass="segmented" alignment="CENTER" spacing="0">
                    <ToggleButton text="Student"  toggleGroup="$role" selected="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <ToggleButton text="Lecturer" toggleGroup="$role" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <ToggleButton text="Admin"    toggleGroup="$role" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="6">
                <Label text="Full Name" styleClass="field-label"/>
                <IconTextField fx:id="fullNameField" icon="user" promptText="Enter your full name" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Email Address" styleClass="field-label"/>
                <IconTextField fx:id="emailField" icon="mail" promptText="your.email@example.com" maxWidth="Infinity"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Password" styleClass="field-label"/>
                    <RevealPasswordField fx:id="passwordField" promptText="Password" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Confirm Password" styleClass="field-label"/>
                    <RevealPasswordField fx:id="confirmField" promptText="Confirm password" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <CheckBox fx:id="agreeTerms" text="I agree to the Platform Rules and Terms of Service" wrapText="true"/>

            <Label fx:id="errorLabel" wrapText="true" managed="false" visible="false" style="-fx-text-fill:#dc2626; -fx-font-size:13px;"/>
            <Button fx:id="registerButton" text="Register  →" styleClass="btn,btn-primary" maxWidth="Infinity" onAction="#onRegister"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Already have an account?" styleClass="muted"/>
                <Hyperlink fx:id="signInLink" text="Sign In" onAction="#onSignIn"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
