<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.QuizResultsController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
<javafx.scene.image.ImageView fitWidth="40" fitHeight="40" preserveRatio="true"><image><javafx.scene.image.Image url="@../images/logo.jpg"/></image></javafx.scene.image.ImageView>
                <Label text="Dashboard" styleClass="nav-link" onMouseClicked="#onDashboard"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Notification bell — populated dynamically from backend -->
                <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                            <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                                   style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                                   StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                                   managed="false" visible="false"/>
                        </StackPane>
                    </graphic>
                    <items>
                        <!-- Items populated by NavbarHelper.loadNotifications() -->
                    </items>
                </MenuButton>
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="✓  Profile" onAction="#onProfile"/>
                        <MenuItem text="→  Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <Label text="Quiz Results" styleClass="page-title"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="672">

                    <!-- Score card -->
                    <VBox styleClass="card" alignment="CENTER" spacing="4">
                        <Label fx:id="scoreLabel"
                               style="-fx-text-fill:#16a34a; -fx-font-size:48px;
                                      -fx-font-weight:bold;"/>
                        <Label fx:id="quizTitleLabel" styleClass="muted"/>
                        <Label fx:id="submittedLabel" styleClass="subtle"/>

                        <HBox spacing="16" alignment="CENTER">
                            <VBox.margin><Insets top="16"/></VBox.margin>
                            <VBox fx:id="correctBox" alignment="CENTER" spacing="2"
                                  style="-fx-background-color:#f0fdf4; -fx-background-radius:8;
                                         -fx-padding:12 24 12 24;">
                                <Label fx:id="correctLabel"
                                       style="-fx-text-fill:#16a34a; -fx-font-size:20px;
                                              -fx-font-weight:bold;"/>
                                <Label text="Correct" styleClass="subtle"/>
                            </VBox>
                            <VBox fx:id="incorrectBox" alignment="CENTER" spacing="2"
                                  style="-fx-background-color:#fef2f2; -fx-background-radius:8;
                                         -fx-padding:12 24 12 24;">
                                <Label fx:id="incorrectLabel"
                                       style="-fx-text-fill:#dc2626; -fx-font-size:20px;
                                              -fx-font-weight:bold;"/>
                                <Label text="Incorrect" styleClass="subtle"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="2"
                                  style="-fx-background-color:#f9fafb; -fx-background-radius:8;
                                         -fx-padding:12 24 12 24;">
                                <Label fx:id="autoLabel"
                                       style="-fx-font-size:14px; -fx-font-weight:bold;"/>
                                <Label text="Submission" styleClass="subtle"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER">
                        <Button text="Back to Dashboard" styleClass="btn,btn-primary"
                                onAction="#onDashboard"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
