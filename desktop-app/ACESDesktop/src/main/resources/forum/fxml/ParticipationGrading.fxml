<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="forum.controllers.ParticipationGradingController"
            stylesheets="@../css/aces.css" styleClass="root"
            prefWidth="1280" prefHeight="820">
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
<HBox alignment="CENTER_LEFT" spacing="8">
    <javafx.scene.image.ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
        <image><javafx.scene.image.Image url="@../images/logo.jpg"/></image>
    </javafx.scene.image.ImageView>
</HBox>
                <Label text="Dashboard"   styleClass="nav-link" onMouseClicked="#onDashboard"/>
                <Label text="Groups"      styleClass="nav-link" onMouseClicked="#onGroups"/>
                <Label text="New Topic"   styleClass="nav-link" onMouseClicked="#onNewTopic"/>
                <Label text="Quiz Center" styleClass="nav-link" onMouseClicked="#onQuizCenter"/>
                <Label text="Grading"     styleClass="nav-link,active"/>
                <Region HBox.hgrow="ALWAYS"/>
                <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                            <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                                   style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                                   StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                                   managed="false" visible="false"/>
                        </StackPane>
                    </graphic>
                    <items>
                    </items>
                </MenuButton>
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="✓  Profile" onAction="#onProfile"/>
                        <MenuItem text="→  Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <Label text="📝 Participation Grading" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="← Back to Dashboard" onAction="#onDashboard" styleClass="muted"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="1120">

                    <Label fx:id="statusLabel" styleClass="muted"
                           managed="false" visible="false"/>

                    <!-- Grading table -->
                    <VBox styleClass="card" spacing="0">
                        <HBox alignment="CENTER_LEFT">
                            <padding><Insets bottom="16"/></padding>
                            <Label text="Student Forum Participation" styleClass="card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="💾 Save All Grades"
                                    styleClass="btn,btn-primary"
                                    onAction="#onSaveGrades"/>
                        </HBox>

                        <TableView fx:id="gradesTable" prefHeight="480">
                            <columns>
                                <TableColumn fx:id="colStudent"       text="STUDENT"       prefWidth="180"/>
                                <TableColumn fx:id="colReplies"       text="REPLIES"       prefWidth="80"/>
                                <TableColumn fx:id="colParticipation" text="PARTICIPATION" prefWidth="120"/>
                                <TableColumn fx:id="colTestAvg"       text="TEST AVG"      prefWidth="180"/>
                                <TableColumn fx:id="colScore"         text="SCORE"         prefWidth="100"/>
                                <TableColumn fx:id="colRemarks"       text="REMARKS"       prefWidth="220"/>
                            </columns>
                            <placeholder>
                                <Label text="No students in your groups yet." styleClass="muted"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>