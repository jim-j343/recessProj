<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="forum.controllers.GroupShowController"
           stylesheets="@../css/aces.css" styleClass="root"
           prefWidth="1280" prefHeight="820">

<BorderPane>
    <top>
        <VBox>
            <HBox styleClass="navbar" alignment="CENTER_LEFT">
<javafx.scene.image.ImageView fitWidth="48" fitHeight="48" preserveRatio="true"><image><javafx.scene.image.Image url="@../images/logo.jpg"/></image></javafx.scene.image.ImageView>
                <Label text="Dashboard" styleClass="nav-link" onMouseClicked="#onDashboard"/>
                <Label text="Groups" styleClass="nav-link,active" onMouseClicked="#onGroups"/>
                <Label fx:id="navMyProgress" text="My Progress" styleClass="nav-link" onMouseClicked="#onDashboard" managed="false" visible="false"/>
                <Label fx:id="navNewTopic" text="New Topic" styleClass="nav-link" onMouseClicked="#onNewTopic" managed="false" visible="false"/>
                <Label fx:id="navQuizCenter" text="Quiz Center" styleClass="nav-link" onMouseClicked="#onQuizCenter" managed="false" visible="false"/>
                <Label fx:id="navGrading" text="Grading" styleClass="nav-link" onMouseClicked="#onGrading" managed="false" visible="false"/>
                <Label fx:id="navMembers" text="Members" styleClass="nav-link" onMouseClicked="#onMembers" managed="false" visible="false"/>
                <Label fx:id="navAnalytics" text="Analytics" styleClass="nav-link" onMouseClicked="#onAnalytics" managed="false" visible="false"/>
                <Label fx:id="navModeration" text="Moderation" styleClass="nav-link" onMouseClicked="#onModeration" managed="false" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Notification bell — populated dynamically from backend -->
                <MenuButton fx:id="notifButton" styleClass="btn-ghost" text="">
                    <graphic>
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 16px;"/>
                            <Label fx:id="notifBadge" text="" styleClass="badge,badge-danger"
                                   style="-fx-font-size: 9px; -fx-padding: 0 4; -fx-background-radius: 10;"
                                   StackPane.alignment="TOP_RIGHT" translateY="-4" translateX="4"
                                   managed="false" visible="false"/>
                        </StackPane>
                    </graphic>
                    <items>
                        <!-- Items populated by NavbarHelper.loadNotifications() -->
                    </items>
                </MenuButton>

                <!-- Profile Dropdown -->
                <MenuButton styleClass="btn-ghost" text="">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="avatarLabel" styleClass="avatar" minWidth="32" minHeight="32" text="?"/>
                            <Label fx:id="userNameLabel" text="Signed in"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="✓  Profile" onAction="#onProfile"/>
                        <MenuItem text="→  Log Out" onAction="#onLogout"/>
                    </items>
                </MenuButton>
            </HBox>
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label fx:id="groupNameLabel"  styleClass="page-title"/>
                    <Label fx:id="courseNameLabel" style="-fx-text-fill:#4f46e5; -fx-font-size:14px; -fx-font-weight:bold;"/>
                    <Label fx:id="groupDescLabel"  styleClass="subtle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="8">
                    <Button text="Go to Forum" styleClass="btn,btn-primary" onAction="#onForum"/>
                    <Button fx:id="editGroupBtn" text="Edit Group" styleClass="btn,btn-secondary" onAction="#onEditGroup" managed="false" visible="false"/>
                    <Button fx:id="deleteGroupBtn" text="Delete Group" style="-fx-background-color:#ef4444; -fx-text-fill:white; -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-background-radius:6; -fx-cursor:hand;" onAction="#onDeleteGroup" managed="false" visible="false"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content">
            <VBox alignment="TOP_CENTER">
                <VBox spacing="24" maxWidth="1120">

                    <!-- Stats -->
                    <HBox spacing="16">
                        <VBox styleClass="card" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="memberCountLabel" text="—"
                                   style="-fx-text-fill:#4f46e5; -fx-font-size:24px; -fx-font-weight:bold;"/>
                            <Label text="Members" styleClass="subtle"/>
                        </VBox>
                        <VBox styleClass="card" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="topicCountLabel" text="—"
                                   style="-fx-text-fill:#16a34a; -fx-font-size:24px; -fx-font-weight:bold;"/>
                            <Label text="Topics" styleClass="subtle"/>
                        </VBox>
                        <VBox styleClass="card" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="warningDaysLabel" text="—"
                                   style="-fx-text-fill:#4b5563; -fx-font-size:24px; -fx-font-weight:bold;"/>
                            <Label text="Days before warning" styleClass="subtle"/>
                        </VBox>
                        <VBox styleClass="card" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="blacklistDaysLabel" text="—"
                                   style="-fx-text-fill:#dc2626; -fx-font-size:24px; -fx-font-weight:bold;"/>
                            <Label text="Blacklist duration (days)" styleClass="subtle"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="24">
                        <!-- Left column: Recent Topics -->
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
                            <Label text="Recent Topics" styleClass="h-sm"/>
                            <VBox fx:id="topicsBox" spacing="8"/>
                            <Label fx:id="noTopicsLabel" text="No topics yet." styleClass="muted" managed="false" visible="false"/>
                        </VBox>

                        <!-- Right column: Members -->
                        <VBox styleClass="card" spacing="0" minWidth="300" maxWidth="400" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Members" styleClass="h-sm"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="addMemberBtn" text="+ Add Member" styleClass="btn-ghost" style="-fx-text-fill:#2563eb; -fx-font-size:12px; -fx-cursor:hand;" onAction="#onAddMember" managed="false" visible="false"/>
                            </HBox>
                            <Region style="-fx-pref-height: 12px;"/>
                            <VBox fx:id="membersBox" spacing="0"/>
                            <Label fx:id="pendingNote" styleClass="subtle"
                                   managed="false" visible="false"/>
                        </VBox>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

    <!-- Modal Overlay for Add Member -->
    <StackPane fx:id="addMemberModal" style="-fx-background-color: rgba(0, 0, 0, 0.4);" managed="false" visible="false">
        <VBox styleClass="card" maxWidth="480" maxHeight="-Infinity" spacing="24" style="-fx-padding: 32; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <Label text="Add a member" styleClass="page-title" style="-fx-font-size: 20px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="✕" style="-fx-font-size: 20px; -fx-text-fill: #9ca3af; -fx-cursor: hand;" onMouseClicked="#closeAddMemberModal"/>
            </HBox>
            
            <!-- Body -->
            <VBox spacing="8">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="newMemberUsernameField" promptText="e.g. atim_grace"/>
                <Label text="They'll be added right away and notified." styleClass="muted" style="-fx-font-size: 13px;"/>
                <Label fx:id="addMemberErrorLabel" text="" styleClass="text-danger" managed="false" visible="false" wrapText="true"/>
            </VBox>
            
            <!-- Footer Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="16">
                <Hyperlink text="Cancel" onAction="#closeAddMemberModal" styleClass="muted" style="-fx-font-size: 15px; -fx-underline: false;"/>
                <Button fx:id="confirmAddMemberBtn" text="Add Member" styleClass="btn,btn-primary" onAction="#confirmAddMember"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Modal Overlay for Delete Group -->
    <StackPane fx:id="deleteGroupModal" style="-fx-background-color: rgba(0, 0, 0, 0.4);" managed="false" visible="false">
        <VBox styleClass="card" maxWidth="480" maxHeight="-Infinity" spacing="24" style="-fx-padding: 32; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <Label text="Delete Group" styleClass="page-title" style="-fx-font-size: 20px; -fx-text-fill: #ef4444;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="✕" style="-fx-font-size: 20px; -fx-text-fill: #9ca3af; -fx-cursor: hand;" onMouseClicked="#closeDeleteGroupModal"/>
            </HBox>
            
            <!-- Body -->
            <VBox spacing="8">
                <Label fx:id="deleteGroupMessage" text="Are you sure you want to delete this group? This cannot be undone." wrapText="true" style="-fx-font-size: 14px;"/>
                <Label fx:id="deleteGroupErrorLabel" text="" styleClass="text-danger" managed="false" visible="false" wrapText="true"/>
            </VBox>
            
            <!-- Footer Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="16">
                <Hyperlink text="Cancel" onAction="#closeDeleteGroupModal" styleClass="muted" style="-fx-font-size: 15px; -fx-underline: false;"/>
                <Button fx:id="confirmDeleteGroupBtn" text="Delete Group" styleClass="btn,badge-danger" style="-fx-padding: 8 16;" onAction="#confirmDeleteGroup"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Modal Overlay for Remove Member -->
    <StackPane fx:id="removeMemberModal" style="-fx-background-color: rgba(0, 0, 0, 0.4);" managed="false" visible="false">
        <VBox styleClass="card" maxWidth="480" maxHeight="-Infinity" spacing="24" style="-fx-padding: 32; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <Label text="Remove Member" styleClass="page-title" style="-fx-font-size: 20px; -fx-text-fill: #ef4444;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="✕" style="-fx-font-size: 20px; -fx-text-fill: #9ca3af; -fx-cursor: hand;" onMouseClicked="#closeRemoveMemberModal"/>
            </HBox>
            
            <!-- Body -->
            <VBox spacing="8">
                <Label text="Reason (optional)" styleClass="field-label"/>
                <TextField fx:id="removeMemberReasonField" promptText="e.g. Inactivity"/>
                <Label fx:id="removeMemberErrorLabel" text="" styleClass="text-danger" managed="false" visible="false" wrapText="true"/>
            </VBox>
            
            <!-- Footer Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="16">
                <Hyperlink text="Cancel" onAction="#closeRemoveMemberModal" styleClass="muted" style="-fx-font-size: 15px; -fx-underline: false;"/>
                <Button fx:id="confirmRemoveMemberBtn" text="Remove" styleClass="btn,badge-danger" style="-fx-padding: 8 16;" onAction="#confirmRemoveMember"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
